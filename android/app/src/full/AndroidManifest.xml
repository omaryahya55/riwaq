<?xml version="1.0" encoding="utf-8"?>
<!--
  النسخة الكاملة (full): فيها خدمة إمكانية الوصول (ضغطة البيت المطوّلة، وأزرار الريموت).
  قوقل Play Protect تحظر تركيبها من خارج المتجر في بعض الدول، فالنسخة الخفيفة (lite) بدونها.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ضغطة البيت المطوّلة تفتح اللوحة السريعة (تنشغل من سكربت التركيب أو من معالج الإعداد) -->
        <service
            android:name=".HomeKeyService"
            android:exported="true"
            android:label="@string/home_key_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
