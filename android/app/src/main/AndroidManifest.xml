<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الإنترنت: الطقس والأسعار والدوريات والأخبار، وصفحة الإعدادات للجوال على شبكة البيت -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- صوت الأذان: منبّه في وقت الصلاة، وخدمة تشغّل الصوت، ونرجع نحط المنبّه بعد إعادة التشغيل -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- تطبيق تلفزيون: بدون شاشة لمس، والريموت هو الأساس -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- أندرويد ١١ وفوق: لازم نعلن إننا نبي نشوف التطبيقات اللي تنفتح (بدون صلاحية QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- واجهات الشركة: نشوف هل هي شغالة (صفحة "الرجوع للواجهة الأصلية") -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tungsten.setupwraith" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.mitv.tvhome" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Riwaq"
        android:networkSecurityConfig="@xml/network_security">

        <!-- رواق نفسه (يفتح من قائمة التطبيقات). دور "الواجهة الرئيسية" في HomeAlias تحت، عشان ينطفي لحاله بدون ما ينحذف التطبيق -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density|fontScale">
            <!-- ضغطة البيت المطوّلة في بعض الأجهزة تنرسل كذا: نفتح اللوحة السريعة -->
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- الواجهة الرئيسية: تطلع لما تضغط زر البيت. صفحة "الرجوع للواجهة الأصلية" تطفيها (والتطبيق يبقى) -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- الرجوع للواجهة الأصلية من التلفزيون نفسه (بدون كمبيوتر) -->
        <activity
            android:name=".RestoreActivity"
            android:exported="false" />

        <!-- الإعدادات: باركود تصوّره بجوالك -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- ضغطة البيت المطوّلة تفتح اللوحة السريعة (تنشغل من سكربت التركيب) -->
        <service
            android:name=".HomeKeyService"
            android:exported="true"
            android:label="@string/home_key_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- صوت الأذان -->
        <receiver android:name=".AdhanReceiver" android:exported="false" />
        <receiver android:name=".AdhanBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- شاشة التوقف -->
        <service
            android:name=".RiwaqDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
